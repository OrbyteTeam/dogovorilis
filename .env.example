# ---------- Обязательные ----------
# Токен бота MAX (выдан организаторами). Только здесь, никогда в коде и коммитах.
MAX_BOT_TOKEN=
# Режим получения событий: polling (локально, без домена) | webhook (VPS, HTTPS) | off (только API/мини-приложение, для проверки сборки)
MAX_MODE=polling
# Публичный HTTPS-адрес сервиса (мини-приложение, вебхуки, return_url). Локально: http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
# Ник бота без @ (для диплинков https://max.ru/<ник>?start=...). Если пусто — берётся из GET /me при старте.
MAX_BOT_USERNAME=
# Секрет для webhook MAX (5–256 символов, только [A-Za-z0-9_-]); нужен только при MAX_MODE=webhook.
# Сгенерировать: openssl rand -hex 24
MAX_WEBHOOK_SECRET=
# Домен для Caddy в прод-профиле (docker compose --profile prod). Локально не нужен.
PUBLIC_HOST=localhost

# ---------- База данных (compose подставляет сам; для запуска вне Docker задайте DATABASE_URL) ----------
POSTGRES_USER=dogovorilis
POSTGRES_PASSWORD=dogovorilis
POSTGRES_DB=dogovorilis
# DATABASE_URL=postgres://dogovorilis:dogovorilis@localhost:5432/dogovorilis

# ---------- Платёжный рейл «ссылка» (тестовые песочницы; см. docs/SPEC.md §9) ----------
# none | yookassa | tbank
PAYMENT_PROVIDER=none
# ЮKassa — ТЕСТОВЫЙ магазин (карты 5555 5555 5555 4444 и т.д.); реальные деньги не движутся
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Т-Банк Интернет-эквайринг — DEMO-терминал (эмуляция СБП через SbpPayTest)
TBANK_TERMINAL_KEY=
TBANK_TERMINAL_PASSWORD=

# ---------- Поведение ----------
# Демо-режим «Открыть как клиент» для проверки одним человеком (помечается в интерфейсе и квитанции)
DEMO_MODE=true
# Часовой пояс для отображения дат
APP_TIMEZONE=Europe/Moscow
# Порт сервиса
PORT=8080
LOG_LEVEL=info
# Только для локальной разработки мини-приложения в браузере без MAX: подставить пользователя вместо initData.
# Работает ТОЛЬКО при NODE_ENV=development. При https:// в PUBLIC_BASE_URL сервис с ним не стартует (ConfigError).
# DEV_FAKE_USER_ID=
